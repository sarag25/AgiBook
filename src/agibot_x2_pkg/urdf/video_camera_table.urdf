<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera "TAVOLO" per il video (2026-09-19): la regista (video_camera.urdf) sta a
  y=+2.0, dal lato sinistro del robot, e il suo busto copre l'angolo del tavolo dove
  si posano mappamondo e portapenne (x -0.15, y -0.4/-0.5). Questa sta fuori dal
  tavolo, a (-0.9, -1.5, 1.5), e guarda (-0.15, -0.35, 0.9): yaw 0.9929, pitch
  0.4120, hfov 1.15. Proiezione a 1280x720: mappamondo ~90 px di larghezza, mano al
  rilascio e angolo del tavolo in quadro. Topic: /video_camera_table/image.
-->
<robot name="video_camera_table">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <link name="video_camera_table_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="video_camera_table_joint" type="fixed">
    <origin xyz="-0.9 -1.5 1.5" rpy="0 0.4120 0.9929"/>
    <parent link="base_link"/>
    <child link="video_camera_table_link"/>
  </joint>
  <gazebo>
    <static>true</static>
  </gazebo>
  <gazebo reference="video_camera_table_link">
    <sensor name="video_camera_table" type="camera">
      <camera>
        <horizontal_fov>1.15</horizontal_fov>
        <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>10</far></clip>
        <camera_info_topic>video_camera_table/camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <topic>video_camera_table/image</topic>
    </sensor>
  </gazebo>
</robot>
