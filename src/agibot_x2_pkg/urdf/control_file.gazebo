<?xml version="1.0"?>
<robot>
    <!-- Gazebo Joint State Publisher -->
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_shoulder_pitch_joint</joint_name>
            <joint_name>left_shoulder_roll_joint</joint_name>
            <joint_name>left_shoulder_yaw_joint</joint_name>
            <joint_name>left_elbow_joint</joint_name>
            <joint_name>left_wrist_yaw_joint</joint_name>
            <joint_name>left_gripper_left_finger_joint</joint_name>
            <joint_name>left_gripper_right_finger_joint</joint_name>

            <joint_name>right_shoulder_pitch_joint</joint_name>
            <joint_name>right_shoulder_roll_joint</joint_name>
            <joint_name>right_shoulder_yaw_joint</joint_name>
            <joint_name>right_elbow_joint</joint_name>
            <joint_name>right_wrist_yaw_joint</joint_name>
            <joint_name>right_gripper_left_finger_joint</joint_name>
            <joint_name>right_gripper_right_finger_joint</joint_name>

            <joint_name>head_yaw_joint</joint_name>
            <joint_name>head_pitch_joint</joint_name>

            <joint_name>waist_pitch_joint</joint_name>
            <joint_name>waist_roll_joint</joint_name>
            <joint_name>waist_yaw_joint</joint_name>

            <joint_name>left_hip_pitch_joint</joint_name>
            <joint_name>left_hip_roll_joint</joint_name>
            <joint_name>left_hip_yaw_joint</joint_name>
            <joint_name>left_knee_joint</joint_name>
            <joint_name>left_ankle_pitch_joint</joint_name>
            <joint_name>left_ankle_roll_joint</joint_name>

            <joint_name>right_hip_pitch_joint</joint_name>
            <joint_name>right_hip_roll_joint</joint_name>
            <joint_name>right_hip_yaw_joint</joint_name>
            <joint_name>right_knee_joint</joint_name>
            <joint_name>right_ankle_pitch_joint</joint_name>
            <joint_name>right_ankle_roll_joint</joint_name>

            <!-- base mobile cinematica (2026-09-13, x2_hand_gazebo.urdf) -->
            <joint_name>base_x_joint</joint_name>
            <joint_name>base_y_joint</joint_name>
            <joint_name>base_z_joint</joint_name>
            <joint_name>base_yaw_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- Plugin per Detachable Joints -->

    <!-- Sensori di contatto sulle DITA (fix 2026-09-06). Prima erano su
         left_tcp/right_tcp: (1) quei reference non esistevano (i link si
         chiamano left_tcp_link/right_tcp_link) quindi i blocchi venivano
         scartati in silenzio; (2) la collision citata (left_tcp_collision)
         non esiste dopo la conversione URDF->SDF; (3) il volume con
         collision vera al centro della bocca bloccava fisicamente il libro
         (vedi commento nei tcp link dell'URDF). Ora: sensore sul dito
         sinistro di ciascun gripper (lo stesso dito a cui punta il
         DetachableJoint dei libri), collision col nome REALE che sdformat
         genera (<link>_collision, i finger sono figli di giunti prismatici
         quindi NON vengono fusi). Topic invariati (/contact_left_tcp e
         /contact_right_tcp, scelti in origine), bridged in gz_bridge.yaml.
         Richiede il plugin gz-sim-contact-system nel world (empty.world). -->
    <gazebo reference="left_gripper_left_finger_link">
      <sensor name='sensor_contact_left' type='contact'>
        <contact>
          <collision>left_gripper_left_finger_link_collision</collision>
          <topic>/contact_left_tcp</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>

    <gazebo reference="right_gripper_left_finger_link">
      <sensor name='sensor_contact_right' type='contact'>
        <contact>
          <collision>right_gripper_left_finger_link_collision</collision>
          <topic>/contact_right_tcp</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>


    <!-- Gazebo ROS 2 Control Plugin -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find agibot_x2_pkg)/config/x2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!--
      Camera testa (RGBD), montata sul link mesh gia' presente
      rgbd_head_front_link (finora solo visual, nessun sensore - vedi
      Overview.md "Nessun sensore camera Gazebo"). L'asse Z locale di
      questo link e' l'asse ottico reale della mesh (verificato
      analiticamente dalla rotazione di rgbd_head_front_joint: Z locale =
      (0.766, 0, -0.643) nel frame di head_pitch_link, avanti e
      leggermente in basso - stesso schema confermato sugli altri 3 link
      camera della testa, es. rgb_head_rear_link ha Z locale = (-1,0,0),
      cioe' all'indietro, coerente col nome "rear"). Il sensore Gazebo
      punta pero' lungo il proprio X locale: la <pose> qui sotto ruota di
      -90 gradi su Y per allineare l'asse ottico del sensore all'asse Z
      reale del link. Depth map attesa da vision/depth_estimator.py in
      modalita' "rgbd" (rgbd_head_front/depth_image dopo il bridge, vedi
      rviz_gaz_control.launch.py).
    -->
    <gazebo reference="rgbd_head_front_link">
        <sensor name="head_camera" type="rgbd_camera">
            <!-- pose rpy = (-90, -90, 0) gradi (era solo pitch -90,
                 2026-08-29): il solo pitch allineava l'asse ottico del
                 sensore (X locale) all'asse Z del link (avanti/basso,
                 corretto) ma lasciava l'"alto" dell'immagine (Z del
                 sensore) puntato verso -X del link = la DESTRA del robot:
                 immagine ruotata di 90 gradi (coste dei libri orizzontali,
                 ripiani verticali - visto a schermo). Il roll aggiuntivo
                 di -90 porta l'alto immagine su +Y del link, che nel frame
                 della testa e' (0.643, 0, 0.766) = avanti/alto: orizzonte
                 dritto. Composizione verificata algebricamente:
                 R = Ry(-90)*Rx(-90) manda sensore X->Z_link (ottico),
                 Z->Y_link (alto), Y->X_link, det=+1. -->
            <pose>0 0 0 -1.5707963 -1.5707963 0</pose>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <!-- 320x240 (era 640x480, 2026-08-29): questa camera serve
                     SOLO al controllo occupazione scaffale (righe/slot vuoti,
                     vedi library_manager_node._refresh_shelf_occupancy) - per
                     vedere i contorni dei dorsi basta e avanza. rgbd_camera
                     renderizza DUE pass (colore+depth) per frame: dimezzare
                     la risoluzione taglia il costo per frame di 4x. Insieme
                     al rate 5 Hz (sotto), il carico totale scende di ~10x -
                     era la causa dell'avvio strangolato (RTF quasi zero,
                     spawner morti, vedi Bugs.md 2026-08-29). ATTENZIONE se
                     si torna a usare depth per pixel_to_3d: gli intrinseci
                     di default di depth_estimator.py (fx=615, cx=320) sono
                     per 640x480, a 320x240 vanno dimezzati. -->
                <image>
                    <width>320</width>
                    <height>240</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>10</far>
                    </clip>
                </depth_camera>
            </camera>
            <always_on>1</always_on>
            <!-- 5 Hz (era 8, 2026-08-29; era 20 in origine): il check di
                 occupazione non ha bisogno di frame rate, e ogni frame in
                 meno e' CPU restituita alla fisica/controller (rendering
                 software, vedi commento risoluzione sopra). -->
            <update_rate>3</update_rate>
            <visualize>true</visualize>
            <topic>rgbd_head_front</topic>
        </sensor>
    </gazebo>

    <!--
      Camere TCP su ENTRAMBE le mani (2026-08-29, riattivate e raddoppiate su
      richiesta - erano state disattivate lo stesso giorno per carico CPU):
      guardano fra le dita per vedere l'oggetto durante la presa. Link/joint
      left_gripper_camera_link / right_gripper_camera_link in
      x2_hand_gazebo.urdf (montati sulla faccia inferiore della piastra base
      di ciascun gripper, asse ottico lungo -Z = direzione delle dita).
      Rispetto alla prima versione (640x480 @ 8Hz) sono a 320x240 @ 5Hz:
      il carico che aveva strangolato l'avvio (vedi Bugs.md) veniva dai
      pixel renderizzati, e per vedere un oggetto a 4-8 cm basta e avanza
      questa risoluzione. near=0.01: la piastra base finisce a 0.005 m
      dalla camera, va tagliata fuori dal frustum (lezione della prima
      versione: near uguale allo spessore della staffa = schermo vuoto).
      NOTA <topic>: per i sensori type="camera" e' il topic COMPLETO
      dell'immagine, non un prefisso (a differenza di type="rgbd_camera") -
      bug gia' pagato sulla camera tavolo, vedi full_scene.urdf.
    -->
  <!--
    <gazebo reference="left_gripper_camera_link">
        <sensor name="tcp_camera_left" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.01</near>
                    <far>2</far>
                </clip>
                <camera_info_topic>tcp_camera_left/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>3</update_rate>
            <visualize>true</visualize>
            <topic>tcp_camera_left/image</topic>
        </sensor>
    </gazebo>
-->
    <!-- Camera TCP DESTRA riattivata come "video" (2026-09-13): il commit
         939db44 "Commented cameras" le aveva spente entrambe per CPU. Serve
         per il filmato della presa (vista dalla mano mentre afferra), quindi
         640x480 @ 15 Hz. Il costo reale e' basso: update_rate e' in tempo
         SIMULATO, a RTF 0.1 sono ~1.5 frame renderizzati al secondo reale.
         Per lo stesso motivo il feed a schermo va a ~1.5 fps: nel montaggio
         va velocizzato di 1/RTF (o registrato con il Video Recorder della
         GUI di Gazebo in "sim time", vedi README "VIDEO"). La sinistra
         resta spenta (non si usa). -->
    <gazebo reference="right_gripper_camera_link">
        <sensor name="tcp_camera_right" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.01</near>
                    <far>2</far>
                </clip>
                <camera_info_topic>tcp_camera_right/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>tcp_camera_right/image</topic>
        </sensor>
    </gazebo>

  <!-- ROS 2 Control Hardware Interface -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_shoulder_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_shoulder_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_shoulder_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_wrist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_shoulder_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_shoulder_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_shoulder_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wrist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="head_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="head_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  
    <joint name="waist_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="waist_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="waist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
