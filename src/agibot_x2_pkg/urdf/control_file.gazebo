<?xml version="1.0"?>
<robot>
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_shoulder_pitch_joint</joint_name>
            <joint_name>left_shoulder_roll_joint</joint_name>
            <joint_name>left_shoulder_yaw_joint</joint_name>
            <joint_name>left_elbow_joint</joint_name>
            <joint_name>left_wrist_yaw_joint</joint_name>
            <joint_name>left_gripper_left_finger_joint</joint_name>
            <joint_name>left_gripper_right_finger_joint</joint_name>

            <joint_name>right_shoulder_pitch_joint</joint_name>
            <joint_name>right_shoulder_roll_joint</joint_name>
            <joint_name>right_shoulder_yaw_joint</joint_name>
            <joint_name>right_elbow_joint</joint_name>
            <joint_name>right_wrist_yaw_joint</joint_name>
            <joint_name>right_gripper_left_finger_joint</joint_name>
            <joint_name>right_gripper_right_finger_joint</joint_name>

            <joint_name>head_yaw_joint</joint_name>
            <joint_name>head_pitch_joint</joint_name>

            <joint_name>waist_pitch_joint</joint_name>
            <joint_name>waist_roll_joint</joint_name>
            <joint_name>waist_yaw_joint</joint_name>

            <joint_name>left_hip_pitch_joint</joint_name>
            <joint_name>left_hip_roll_joint</joint_name>
            <joint_name>left_hip_yaw_joint</joint_name>
            <joint_name>left_knee_joint</joint_name>
            <joint_name>left_ankle_pitch_joint</joint_name>
            <joint_name>left_ankle_roll_joint</joint_name>

            <joint_name>right_hip_pitch_joint</joint_name>
            <joint_name>right_hip_roll_joint</joint_name>
            <joint_name>right_hip_yaw_joint</joint_name>
            <joint_name>right_knee_joint</joint_name>
            <joint_name>right_ankle_pitch_joint</joint_name>
            <joint_name>right_ankle_roll_joint</joint_name>

            <joint_name>base_x_joint</joint_name>
            <joint_name>base_y_joint</joint_name>
            <joint_name>base_z_joint</joint_name>
            <joint_name>base_yaw_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="left_gripper_left_finger_link">
      <sensor name='sensor_contact_left' type='contact'>
        <contact>
          <collision>left_gripper_left_finger_link_collision</collision>
          <topic>/contact_left_tcp</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>

    <gazebo reference="left_gripper_right_finger_link">
      <sensor name='sensor_contact_left_b' type='contact'>
        <contact>
          <collision>left_gripper_right_finger_link_collision</collision>
          <topic>/contact_left_tcp_b</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>

    <gazebo reference="right_gripper_left_finger_link">
      <sensor name='sensor_contact_right' type='contact'>
        <contact>
          <collision>right_gripper_left_finger_link_collision</collision>
          <topic>/contact_right_tcp</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>

    <gazebo reference="right_gripper_right_finger_link">
      <sensor name='sensor_contact_right_b' type='contact'>
        <contact>
          <collision>right_gripper_right_finger_link_collision</collision>
          <topic>/contact_right_tcp_b</topic>
        </contact>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </gazebo>


    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find agibot_x2_pkg)/config/x2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <gazebo reference="rgbd_head_front_link">
        <sensor name="head_camera" type="rgbd_camera">
            <pose>0 0 0 -1.5707963 -1.5707963 0</pose>
            <camera>
                <triggered>true</triggered>
                <trigger_topic>/head_camera/trigger</trigger_topic>
                <horizontal_fov>1.0</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1440</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.05</near>
                        <far>10</far>
                    </clip>
                </depth_camera>
            </camera>
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>false</visualize>
            <topic>head_camera</topic>
        </sensor>
    </gazebo>

    <gazebo reference="left_gripper_camera_link">
        <sensor name="tcp_camera_left" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.01</near>
                    <far>2</far>
                </clip>
                <camera_info_topic>tcp_camera_left/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>tcp_camera_left/image</topic>
        </sensor>
    </gazebo>
    <gazebo reference="right_gripper_camera_link">
        <sensor name="tcp_camera_right" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.01</near>
                    <far>2</far>
                </clip>
                <camera_info_topic>tcp_camera_right/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>tcp_camera_right/image</topic>
        </sensor>
    </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_shoulder_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_shoulder_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_shoulder_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_wrist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_shoulder_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_shoulder_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_shoulder_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wrist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="head_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="head_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  
    <joint name="waist_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="waist_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="waist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="left_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_ankle_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="right_hip_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_ankle_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_ankle_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="base_x_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_y_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_z_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
</robot>