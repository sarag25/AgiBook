<?xml version="1.0" encoding="utf-8"?>
<!--
  Libreria a 4 scaffali – compatibile RViz2 e Gazebo (Harmonic / Classic)

  Dimensioni esterne:
    Larghezza : 0.800 m  (asse X, da -0.400 a +0.400)
    Profondità : 0.300 m  (asse Y, da -0.150 a +0.150)
    Altezza    : 1.350 m  (asse Z, da 0.000 a 1.350)  ← raggiungibile da Agibot X2

  Origine: centro della base a livello del pavimento (z = 0).

  Struttura (8 pannelli in legno, spessore 22 mm):
    - pannello sinistro   : x ∈ [-0.400, -0.378]
    - pannello destro     : x ∈ [ 0.378,  0.400]
    - pannello posteriore : y ∈ [-0.150, -0.128]
    - ripiano base        : z ∈ [0.000,  0.022]   → superficie a z = 0.022
    - scaffale 1          : z ∈ [0.327,  0.349]   → superficie a z = 0.349
    - scaffale 2          : z ∈ [0.649,  0.671]   → superficie a z = 0.671
    - scaffale 3          : z ∈ [0.971,  0.993]   → superficie a z = 0.993
    - piano di copertura  : z ∈ [1.328,  1.350]

  Altezze scomparti disponibili per i libri (≈ 30 cm ciascuno):
    Scomparto 1 : 0.022 → 0.327  (30.5 cm)
    Scomparto 2 : 0.349 → 0.649  (30.0 cm)
    Scomparto 3 : 0.671 → 0.971  (30.0 cm)
    Scomparto 4 : 0.993 → 1.328  (33.5 cm)
-->
<robot name="bookshelf">

  <link name="base_link">

    <!-- ─── Inerzia (oggetto statico in Gazebo; valori approssimativi) ─── -->
    <inertial>
      <origin xyz="0 0 0.675" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="3.645" ixy="0.0" ixz="0.0"
               iyy="4.374" iyz="0.0"
               izz="0.972"/>
    </inertial>

    <!-- ─── VISUAL: mesh GLB (esportata Z-up) per RViz2 e Gazebo ─── -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agibot_x2_pkg/meshes/bookshelf.glb"/>
      </geometry>
    </visual>

    <!-- ─── COLLISION: box separati per ogni pannello ─── -->

    <!-- pannello sinistro -->
    <collision>
      <origin xyz="-0.389 0.000 0.675" rpy="0 0 0"/>
      <geometry><box size="0.022 0.300 1.350"/></geometry>
    </collision>

    <!-- pannello destro -->
    <collision>
      <origin xyz="0.389 0.000 0.675" rpy="0 0 0"/>
      <geometry><box size="0.022 0.300 1.350"/></geometry>
    </collision>

    <!-- pannello posteriore -->
    <collision>
      <origin xyz="0.000 -0.139 0.675" rpy="0 0 0"/>
      <geometry><box size="0.756 0.022 1.350"/></geometry>
    </collision>

    <!-- ripiano base -->
    <collision>
      <origin xyz="0.000 0.011 0.011" rpy="0 0 0"/>
      <geometry><box size="0.756 0.278 0.022"/></geometry>
    </collision>

    <!-- scaffale 1  (z ≈ 0.338) -->
    <collision>
      <origin xyz="0.000 0.011 0.338" rpy="0 0 0"/>
      <geometry><box size="0.756 0.278 0.022"/></geometry>
    </collision>

    <!-- scaffale 2  (z ≈ 0.660) -->
    <collision>
      <origin xyz="0.000 0.011 0.660" rpy="0 0 0"/>
      <geometry><box size="0.756 0.278 0.022"/></geometry>
    </collision>

    <!-- scaffale 3  (z ≈ 0.982) -->
    <collision>
      <origin xyz="0.000 0.011 0.982" rpy="0 0 0"/>
      <geometry><box size="0.756 0.278 0.022"/></geometry>
    </collision>

    <!-- piano di copertura -->
    <collision>
      <origin xyz="0.000 0.011 1.339" rpy="0 0 0"/>
      <geometry><box size="0.756 0.278 0.022"/></geometry>
    </collision>

  </link>

  <!-- ─── Tag Gazebo (Classic e Harmonic) ─── -->

  <!-- Oggetto statico: non risponde alla fisica, non si muove -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <!-- Solo attrito/rigidezza contatto: NESSUN <material> qui (2026-08-11).
       "Gazebo/Wood" era un materiale con nome della libreria di Gazebo
       Classic - non esiste in Gazebo Sim/Harmonic (ogre2). Quando non
       riusciva a risolverlo, sovrascriveva la texture PBR incorporata nel
       bookshelf.glb con un materiale piatto/senza texture (da cui "tavolo
       e libreria non tengono la texture ma i libri sì" - i libri, generati
       da manual_scene_placer.py, non hanno mai avuto un blocco <material>
       qui, per questo la loro texture .glb è sempre rimasta intatta). -->
  <gazebo reference="base_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e6</kp>
    <kd>100.0</kd>
  </gazebo>

  <!--
    Camera "fototessera" dello scaffale (2026-09-06): la foto di
    identificazione ("foto primo scaffale fornita al robot" nella PIPELINE
    di src/TODO) ad ALTA risoluzione, senza Blender. Fissa alla libreria,
    0.75 m davanti al fronte (+Y locale), centrata sui 4 libri di test del
    ripiano alto (local_x=-0.23 = centro della fascia y=-0.335..-0.122 in
    world con shelf yaw 90; z=1.10 = quota dei dorsi), guarda verso -Y
    (rpy yaw -90: l'asse X del sensore - "avanti" per le camere Gazebo -
    finisce su -Y locale, l'alto immagine resta +Z). FOV stretto (0.9 rad)
    per riempire il frame coi dorsi e tenere fuori il corpo del robot, che
    sta a local_x=0. 960x720 (l'unica camera ad alta risoluzione: serve
    all'OCR dei titoli) a 1 Hz: costo di rendering minimo.
    Il robot NON occlude: sta di lato rispetto all'asse camera-libri.
    Uso: library_manager trigger "data: 'shelf'" (vedi library_manager_node).
  -->
  <link name="shelf_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <!-- Posa rialzata (2026-09-06, era z=1.10 ad angolo zero): a quota dorsi
       la spalla destra del robot (top ~1.13 m) e la testa stavano nel
       corridoio visivo e riempivano mezzo frame. Da z=1.50 con pitch di
       +0.55 rad (~32 gradi verso il basso) il raggio passa sopra spalla e
       testa e cade sui dorsi a z~1.10: verificato geometricamente (raggio a
       z~1.29 sopra la testa, ~1.29 sopra la spalla al loro x). rpy: prima
       yaw -90 (guarda -Y locale = verso lo scaffale), poi pitch. -->
  <joint name="shelf_camera_joint" type="fixed">
    <!-- x -0.23 -> -0.16 (2026-09-06): con la camera centrata sui libri il
         mappamondo (local x=+0.02) restava fuori dal bordo sinistro del
         frame - SAM3 trovava 0 "object". -0.16 = punto medio delle 6
         entita' (local x da -0.335 a +0.02); hfov 0.9 -> 1.0 per margine. -->
    <origin xyz="-0.16 0.75 1.50" rpy="0 0.55 -1.5707963"/>
    <parent link="base_link"/>
    <child link="shelf_camera_link"/>
  </joint>
  <gazebo reference="shelf_camera_link">
    <sensor name="shelf_camera" type="camera">
      <camera>
        <horizontal_fov>1.0</horizontal_fov>
        <image><width>960</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>3</far></clip>
        <camera_info_topic>shelf_camera/camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>1</update_rate>
      <visualize>true</visualize>
      <topic>shelf_camera/image</topic>
    </sensor>
  </gazebo>

</robot>
