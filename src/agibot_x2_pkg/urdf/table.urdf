<?xml version="1.0" encoding="utf-8"?>
<!--
  Tavolo di staging vuoto – compatibile RViz2 e Gazebo (Harmonic / Classic)

  Dimensioni esterne (identiche a environment/table/create_table.py,
  DEFAULT_WIDTH/DEFAULT_DEPTH/TABLE_HEIGHT - stesse quote del meshes/table.glb
  già esportato, nessun numero re-inventato qui):
    Larghezza  : 1.200 m  (asse X, da -0.600 a +0.600)
    Profondità : 0.900 m  (asse Y, da -0.450 a +0.450)
    Altezza    : 0.750 m  (superficie del piano, asse Z)

  Origine: centro dell'ingombro a terra, z = 0 (stessa convenzione di
  bookshelf.urdf).

  Struttura (piano + 4 gambe, spessore piano 45 mm, gambe 40x40 mm inserite
  di 50 mm dai bordi):
    - piano        : z ∈ [0.705, 0.750]  → superficie a z = 0.750
    - gambe        : z ∈ [0.000, 0.705], centrate su x = ±0.550, y = ±0.400

  ALTEZZA ALZATA IL 2026-08-10 (era 0.500 m): il robot ora ha base fissa
  vicinissima a libreria e tavolo (vedi create_full_scene.py) e non piega
  mai le gambe, quindi il tavolo deve stare vicino all'altezza spalla
  (~1.06 m) per essere raggiungibile dal solo braccio - vedi Gazebo.md
  "Raggiungibilita del braccio".

  meshes/table.glb committato ha ancora la geometria VECCHIA (0.500 m):
  in questo ambiente non è disponibile Blender per ri-esportarlo (vedi
  Bugs.md), quindi la mesh visual viene scalata solo sull'asse Z
  (scale="1 1 1.5" = 0.75/0.50) come soluzione temporanea - rimuovere lo
  scale non appena table.glb viene rigenerato da Blender alla quota giusta.
-->
<robot name="table">

  <link name="base_link">

    <!-- ─── Inerzia (oggetto statico in Gazebo; valori approssimativi) ─── -->
    <inertial>
      <origin xyz="0 0 0.375" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="1.06" ixy="0.0" ixz="0.0"
               iyy="1.69" iyz="0.0"
               izz="2.25"/>
    </inertial>

    <!-- ─── VISUAL: mesh GLB (esportata Z-up) per RViz2 e Gazebo ───
         scale Z-only = 1.5 (0.75/0.50): tappabuchi finché table.glb non
         viene rigenerato da Blender alla quota 0.75 m, vedi nota sopra -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agibot_x2_pkg/meshes/table.glb" scale="1 1 1.5"/>
      </geometry>
    </visual>

    <!-- ─── COLLISION: box separati per piano e gambe ─── -->

    <!-- piano -->
    <collision>
      <origin xyz="0.000 0.000 0.7275" rpy="0 0 0"/>
      <geometry><box size="1.200 0.900 0.045"/></geometry>
    </collision>

    <!-- gamba anteriore destra -->
    <collision>
      <origin xyz="0.550 0.400 0.3525" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.705"/></geometry>
    </collision>

    <!-- gamba anteriore sinistra -->
    <collision>
      <origin xyz="0.550 -0.400 0.3525" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.705"/></geometry>
    </collision>

    <!-- gamba posteriore destra -->
    <collision>
      <origin xyz="-0.550 0.400 0.3525" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.705"/></geometry>
    </collision>

    <!-- gamba posteriore sinistra -->
    <collision>
      <origin xyz="-0.550 -0.400 0.3525" rpy="0 0 0"/>
      <geometry><box size="0.040 0.040 0.705"/></geometry>
    </collision>

  </link>

  <!-- ─── Tag Gazebo (Classic e Harmonic) ─── -->

  <!-- Oggetto statico: non risponde alla fisica, non si muove -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <!-- Camera tavolo (2026-08-30): stessa camera di full_scene.urdf, per la
       scena grasp_test dove il tavolo e' un modello separato. Origine di
       questo file = centro del tavolo a terra, quindi la camera sta a
       (0, 0, 1.55) = 0.80 m sopra il piano (0.75), guarda in basso. Stesso
       topic table_camera/image: le due scene non convivono mai. -->
<!-- Camera tavolo RIATTIVATA e ripuntata (2026-09-06): era commentata e
       comunque inutile per l'ISBN (640x480 a 0.80 m dal piano = 13 px/cm,
       un codice a barre EAN va decodificato con >= ~50 px/cm - verificato
       con pyzbar sulle texture dei retro: decodifica fino a scala 0.35-0.5
       dei 110 px/cm originali). Ora: sopra il PUNTO DI RILASCIO di
       pick_test_book (world (-0.29, -0.465) = local (0.405, -0.11)), 0.55 m
       sopra il piano, hfov 0.6 rad -> inquadra 35 x 26 cm a 1920x1440 =
       55 px/cm sul retro del libro posato a faccia in giu'. 1 Hz: il
       rendering e' caro, basta una foto. Nessuna collision (non ostacola
       il braccio). Topic invariati: table_camera/image, camera_info.
       RICENTRATA e allargata (2026-09-13): il punto di rilascio e' salito a
       world y=-0.37 (TABLE_RELEASE_Y) e il tavolo si e' spostato a
       ly=-0.93: la camera era rimasta a world y=-0.525, 15 cm piu' in la',
       e il libro usciva dal frame (foto con l'ISBN tagliato). Ora centro a
       world (-0.29, -0.40) = local (0.53, -0.11), hfov 0.8 rad e 2560x1920:
       inquadra 47 x 35 cm (world y da -0.22 a -0.57: bordo vicino del
       tavolo compreso) restando a ~55 px/cm per pyzbar. -->
  <link name="table_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <joint name="table_camera_joint" type="fixed">
    <origin xyz="0.53 -0.11 1.30" rpy="0 1.5707963 0"/>
    <parent link="base_link"/>
    <child link="table_camera_link"/>
  </joint>
  <!-- table_camera RIMOSSA il 2026-09-17: l'ISBN si legge con la head_camera
       con il libro in mano (pick_test_book -p head_isbn:=true). -->

  <!-- Solo attrito/rigidezza contatto: NESSUN <material> qui (2026-08-11),
       stesso motivo/fix di bookshelf.urdf - vedi il commento lì. -->
  <gazebo reference="base_link">
    <mu1>0.5</mu1>  <!-- legno verniciato (era 0.8, 2026-09-13) -->
    <mu2>0.5</mu2>
    <kp>1e6</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>
