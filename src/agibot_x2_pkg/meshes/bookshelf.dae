<?xml version="1.0" encoding="utf-8"?>
<!--
  Bookshelf mesh – Collada 1.4.1
  Dimensions: 0.800 m (W) x 0.300 m (D) x 1.350 m (H)
  Origin: bottom-centre of the unit (z=0 = floor level)
  Coordinate system: Z_UP (ROS / Gazebo convention)

  Structure (8 panels):
    Left panel   : x ∈ [-0.400, -0.378], full height
    Right panel  : x ∈ [ 0.378,  0.400], full height
    Back panel   : y ∈ [-0.150, -0.128], full height
    Bottom board : z ∈ [0.000,  0.022]
    Shelf 1      : z ∈ [0.327,  0.349]  → books rest at z=0.349
    Shelf 2      : z ∈ [0.649,  0.671]  → books rest at z=0.671
    Shelf 3      : z ∈ [0.971,  0.993]  → books rest at z=0.993
    Top board    : z ∈ [1.328,  1.350]
-->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <created>2026-06-28</created>
    <modified>2026-06-28</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_effects>
    <effect id="Wood-effect" name="Wood-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission><color sid="emission">0.0 0.0 0.0 1</color></emission>
            <ambient><color sid="ambient">0.27 0.18 0.08 1</color></ambient>
            <diffuse><color sid="diffuse">0.545 0.353 0.169 1</color></diffuse>
            <specular><color sid="specular">0.10 0.09 0.07 1</color></specular>
            <shininess><float sid="shininess">15</float></shininess>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="Wood" name="Wood">
      <instance_effect url="#Wood-effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="bookshelf-mesh" name="bookshelf">
      <mesh>

        <!-- ═══════════════════════════════════════════════
             POSITIONS  (64 vertices × 3 = 192 floats)
             Panels listed in order:
               P0 Left  P1 Right  P2 Back  P3 Bottom
               P4 Shelf1  P5 Shelf2  P6 Shelf3  P7 Top
             Within each panel:
               v0(x0,y0,z0) v1(x1,y0,z0) v2(x1,y1,z0) v3(x0,y1,z0)
               v4(x0,y0,z1) v5(x1,y0,z1) v6(x1,y1,z1) v7(x0,y1,z1)
        ═══════════════════════════════════════════════ -->
        <source id="bookshelf-positions">
          <float_array id="bookshelf-positions-array" count="192">
            -0.400 -0.150  0.000   -0.378 -0.150  0.000   -0.378  0.150  0.000   -0.400  0.150  0.000
            -0.400 -0.150  1.350   -0.378 -0.150  1.350   -0.378  0.150  1.350   -0.400  0.150  1.350

             0.378 -0.150  0.000    0.400 -0.150  0.000    0.400  0.150  0.000    0.378  0.150  0.000
             0.378 -0.150  1.350    0.400 -0.150  1.350    0.400  0.150  1.350    0.378  0.150  1.350

            -0.378 -0.150  0.000    0.378 -0.150  0.000    0.378 -0.128  0.000   -0.378 -0.128  0.000
            -0.378 -0.150  1.350    0.378 -0.150  1.350    0.378 -0.128  1.350   -0.378 -0.128  1.350

            -0.378 -0.128  0.000    0.378 -0.128  0.000    0.378  0.150  0.000   -0.378  0.150  0.000
            -0.378 -0.128  0.022    0.378 -0.128  0.022    0.378  0.150  0.022   -0.378  0.150  0.022

            -0.378 -0.128  0.327    0.378 -0.128  0.327    0.378  0.150  0.327   -0.378  0.150  0.327
            -0.378 -0.128  0.349    0.378 -0.128  0.349    0.378  0.150  0.349   -0.378  0.150  0.349

            -0.378 -0.128  0.649    0.378 -0.128  0.649    0.378  0.150  0.649   -0.378  0.150  0.649
            -0.378 -0.128  0.671    0.378 -0.128  0.671    0.378  0.150  0.671   -0.378  0.150  0.671

            -0.378 -0.128  0.971    0.378 -0.128  0.971    0.378  0.150  0.971   -0.378  0.150  0.971
            -0.378 -0.128  0.993    0.378 -0.128  0.993    0.378  0.150  0.993   -0.378  0.150  0.993

            -0.378 -0.128  1.328    0.378 -0.128  1.328    0.378  0.150  1.328   -0.378  0.150  1.328
            -0.378 -0.128  1.350    0.378 -0.128  1.350    0.378  0.150  1.350   -0.378  0.150  1.350
          </float_array>
          <technique_common>
            <accessor source="#bookshelf-positions-array" count="64" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <vertices id="bookshelf-vertices">
          <input semantic="POSITION" source="#bookshelf-positions"/>
        </vertices>

        <!-- ═══════════════════════════════════════════════
             TRIANGLES  (8 panels × 12 tri = 96 triangles)
             Per panel with base offset o:
               bottom: o+0,o+1,o+2  o+0,o+2,o+3
               top:    o+4,o+6,o+5  o+4,o+7,o+6
               -Y:     o+0,o+4,o+5  o+0,o+5,o+1
               +Y:     o+3,o+2,o+6  o+3,o+6,o+7
               -X:     o+0,o+3,o+7  o+0,o+7,o+4
               +X:     o+1,o+5,o+6  o+1,o+6,o+2
        ═══════════════════════════════════════════════ -->
        <triangles count="96" material="Wood">
          <input semantic="VERTEX" source="#bookshelf-vertices" offset="0"/>
          <p>
            0 1 2   0 2 3   4 6 5   4 7 6   0 4 5   0 5 1   3 2 6   3 6 7   0 3 7   0 7 4   1 5 6   1 6 2
            8 9 10  8 10 11  12 14 13  12 15 14  8 12 13  8 13 9  11 10 14  11 14 15  8 11 15  8 15 12  9 13 14  9 14 10
            16 17 18  16 18 19  20 22 21  20 23 22  16 20 21  16 21 17  19 18 22  19 22 23  16 19 23  16 23 20  17 21 22  17 22 18
            24 25 26  24 26 27  28 30 29  28 31 30  24 28 29  24 29 25  27 26 30  27 30 31  24 27 31  24 31 28  25 29 30  25 30 26
            32 33 34  32 34 35  36 38 37  36 39 38  32 36 37  32 37 33  35 34 38  35 38 39  32 35 39  32 39 36  33 37 38  33 38 34
            40 41 42  40 42 43  44 46 45  44 47 46  40 44 45  40 45 41  43 42 46  43 46 47  40 43 47  40 47 44  41 45 46  41 46 42
            48 49 50  48 50 51  52 54 53  52 55 54  48 52 53  48 53 49  51 50 54  51 54 55  48 51 55  48 55 52  49 53 54  49 54 50
            56 57 58  56 58 59  60 62 61  60 63 62  56 60 61  56 61 57  59 58 62  59 62 63  56 59 63  56 63 60  57 61 62  57 62 58
          </p>
        </triangles>

      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Bookshelf" name="Bookshelf" type="NODE">
        <instance_geometry url="#bookshelf-mesh">
          <bind_material>
            <technique_common>
              <instance_material symbol="Wood" target="#Wood"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
