<?xml version="1.0" encoding="UTF-8"?>
<robot name="agibot_x2">
    <!-- File semantico del robot: definisce Planning Groups per MoveIt, basati sulla struttura dell'URDF (x2_hand_gazebo.urdf). -->
    
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="pelvis"/>
    
    <!-- Gruppo Braccio Sinistro -->
    <group name="left_arm">
        <chain base_link="torso_link" tip_link="left_wrist_yaw_link"/>
    </group>

    <!-- Gruppo Braccio Destro -->
    <group name="right_arm">
        <chain base_link="torso_link" tip_link="right_wrist_yaw_link"/>
    </group>

    <!-- Gruppo Gripper Sinistro -->
    <group name="left_gripper">
        <joint name="left_gripper_left_finger_joint"/>
        <joint name="left_gripper_right_finger_joint"/>
    </group>

    <!-- Gruppo Gripper Destro -->
    <group name="right_gripper">
        <joint name="right_gripper_left_finger_joint"/>
        <joint name="right_gripper_right_finger_joint"/>
    </group>

    <!-- Pose predefinite (es. posizione di stasi/home) -->
    <group_state name="home" group="right_arm">
        <joint name="right_shoulder_pitch_joint" value="0.0"/>
        <joint name="right_shoulder_roll_joint" value="0.0"/>
        <joint name="right_shoulder_yaw_joint" value="0.0"/>
        <joint name="right_elbow_joint" value="0.0"/>
        <joint name="right_wrist_yaw_joint" value="0.0"/>
    </group_state>

    <!-- Disabilitazione collisioni tra link adiacenti o fissi -->
    <!-- Original pairs -->
    <disable_collisions link1="left_wrist_yaw_link" link2="left_gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="right_wrist_yaw_link" link2="right_gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="left_gripper_base_link" link2="left_gripper_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base_link" link2="right_gripper_left_finger_link" reason="Adjacent"/>

    <!-- Pairs reported as colliding at start state (CheckStartStateCollision) -->
    <disable_collisions link1="head_pitch_link" link2="head_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="head_pitch_link" link2="imu_in_head_link" reason="Adjacent"/>
    <disable_collisions link1="head_pitch_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="head_yaw_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="imu_in_pelvis_link" link2="pelvis" reason="Adjacent"/>
    <disable_collisions link1="imu_in_torso_link" link2="torso_link" reason="Adjacent"/>
    <disable_collisions link1="left_ankle_pitch_link" link2="left_ankle_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_ankle_pitch_link" link2="left_knee_link" reason="Never"/>
    <disable_collisions link1="left_elbow_link" link2="left_shoulder_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="left_hip_pitch_link" link2="left_hip_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_hip_pitch_link" link2="pelvis" reason="Never"/>
    <disable_collisions link1="left_hip_roll_link" link2="pelvis" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_pitch_link" link2="torso_link" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_roll_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="pelvis" link2="right_hip_pitch_link" reason="Never"/>
    <disable_collisions link1="pelvis" link2="right_hip_roll_link" reason="Adjacent"/>
    <disable_collisions link1="pelvis" link2="waist_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="rgb_head_rear_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="rgbd_head_front_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="right_ankle_pitch_link" link2="right_ankle_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_ankle_pitch_link" link2="right_knee_link" reason="Never"/>
    <disable_collisions link1="right_elbow_link" link2="right_shoulder_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base_link" link2="right_gripper_camera_link" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base_link" link2="right_gripper_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="right_hip_pitch_link" link2="right_hip_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_pitch_link" link2="right_shoulder_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_pitch_link" link2="torso_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_roll_link" link2="torso_link" reason="Never"/>
    <disable_collisions link1="torso_link" link2="waist_pitch_link" reason="Adjacent"/>
</robot>