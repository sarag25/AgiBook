<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="bookshelf_world">

    <!--
      World "vuoto": solo piano + luce, nessuna libreria/tavolo placeholder.
      Stessa fisica/plugin/luce di bookshelf.world, senza i modelli
      hardcoded (libreria, libri, deposit_table) - usalo quando spawni la
      libreria/tavolo REALI generati da Blender (manual_scene.launch.py),
      per non farli sovrapporre al placeholder di bookshelf.world:

        ros2 launch agibot_x2_pkg gazebo.launch.py world:=empty.world

      Nome del world lasciato uguale a bookshelf.world ("bookshelf_world")
      apposta: gazebo.launch.py referenzia questo nome nel bridge dei topic
      (/world/bookshelf_world/model/...), cambiarlo richiederebbe anche di
      aggiornare quello.
    -->

    <!-- Fisica -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugin fisico Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Contact system (2026-09-06): senza, i sensori type="contact" del
         gripper (control_file.gazebo) non pubblicano nulla. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Luce solare (sostituisce model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Luce da lettura davanti allo scaffale (2026-09-06): l'interno
         dello scaffale resta in ombra con la sola luce direzionale e i
         dorsi escono scuri nella foto della shelf_camera - male per
         l'OCR. Punto luce sopra/davanti al fronte scaffale (che con i
         default shelf_x=0.40/yaw=90 sta a x~0.25): illumina i dorsi senza
         accecare la scena. -->
    <light name="shelf_light" type="point">
      <pose>0.0 -0.2 1.7 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>4.0</range>
        <constant>0.4</constant>
        <linear>0.35</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Piano terra (sostituisce model://ground_plane) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
