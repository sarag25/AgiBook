<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="bookshelf_world">

    <!-- Fisica -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugin fisico Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Luce solare (sostituisce model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Piano terra (sostituisce model://ground_plane) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== LIBRERIA ===== -->
    <model name="bookshelf">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>

      <link name="back_panel">
        <pose>0 -0.15 0.9 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.8 0.03 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.8 0.03 1.8</size></box></geometry>
        </collision>
      </link>

      <link name="left_panel">
        <pose>-0.39 0 0.9 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.02 0.3 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.02 0.3 1.8</size></box></geometry>
        </collision>
      </link>

      <link name="right_panel">
        <pose>0.39 0 0.9 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.02 0.3 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.02 0.3 1.8</size></box></geometry>
        </collision>
      </link>

      <link name="shelf_0">
        <pose>0 0 0.02 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.8 0.3 0.04</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.8 0.3 0.04</size></box></geometry></collision>
      </link>

      <link name="shelf_1">
        <pose>0 0 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.8 0.3 0.04</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.8 0.3 0.04</size></box></geometry></collision>
      </link>

      <link name="shelf_2">
        <pose>0 0 1.0 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.8 0.3 0.04</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.8 0.3 0.04</size></box></geometry></collision>
      </link>

      <link name="shelf_3">
        <pose>0 0 1.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.8 0.3 0.04</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.8 0.3 0.04</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===== LIBRI ripiano 1 ===== -->
    <model name="book_1">
      <pose>1.5 -0.05 0.62 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.2 0.22</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.2 0.22</size></box></geometry></collision>
        <inertial><mass>0.35</mass>
          <inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.003</izz></inertia>
        </inertial>
      </link>
    </model>

    <model name="book_2">
      <pose>1.5 0.05 0.62 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.2 0.20</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.2 0.20</size></box></geometry></collision>
        <inertial><mass>0.30</mass>
          <inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0004</iyy><iyz>0</iyz><izz>0.002</izz></inertia>
        </inertial>
      </link>
    </model>

    <model name="book_3">
      <pose>1.5 0.15 0.62 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.2 0.24</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.2 0.24</size></box></geometry></collision>
        <inertial><mass>0.40</mass>
          <inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0006</iyy><iyz>0</iyz><izz>0.003</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- ===== LIBRI ripiano 2 ===== -->
    <model name="book_4">
      <pose>1.5 -0.1 1.12 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.2 0.20</size></box></geometry>
          <material><ambient>0.8 0.5 0.0 1</ambient><diffuse>0.8 0.5 0.0 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.2 0.20</size></box></geometry></collision>
        <inertial><mass>0.30</mass>
          <inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0004</iyy><iyz>0</iyz><izz>0.002</izz></inertia>
        </inertial>
      </link>
    </model>

    <model name="book_5">
      <pose>1.5 0.05 1.12 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.04 0.2 0.22</size></box></geometry>
          <material><ambient>0.5 0.0 0.8 1</ambient><diffuse>0.5 0.0 0.8 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.04 0.2 0.22</size></box></geometry></collision>
        <inertial><mass>0.35</mass>
          <inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.003</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- ===== TAVOLO deposito ===== -->
    <model name="deposit_table">
      <static>true</static>
      <pose>-0.8 0 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.4 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.02</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.6 0.6 0.02</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
