<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agibot_x2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import agibot_x2 urdf file -->
    <xacro:include filename="$(find agibot_x2_pkg)/urdf/x2_hand_gazebo.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="agibot_x2.ros2_control.xacro" />


    <xacro:agibot_x2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
